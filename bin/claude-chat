#!/bin/bash
#
# Wrapper for the claude-chat CLI, for the PATH.
#
# Installation:
#   1. Copy this script to ~/.hermes/claude-chat (or any directory
#      on your PATH).
#   2. Set PLUGIN_PATH to the directory where the plugin is installed
#      (Hermes default: ~/.hermes/plugins/claude-chat-index).
#
# Usage: claude-chat <command> [args]
# Commands: list, search <term>, absorb <number>, --help

# Plugin directory (the plugin uses $HOME/.claude, so HOME must be set)
PLUGIN_PATH="${CLAUDE_CHAT_PLUGIN_DIR:-$HOME/.hermes/plugins/claude-chat-index}"

if [ ! -f "$PLUGIN_PATH/src/cli.js" ]; then
    echo "Error: Claude Chat Index plugin not found at $PLUGIN_PATH/src/cli.js"
    echo "Install with: hermes plugins install git@github.com:erickstryck/claude-chat-index.git"
    echo "Or set CLAUDE_CHAT_PLUGIN_DIR to the plugin directory."
    exit 1
fi

# exec: replaces the shell process with node (no extra parent process)
exec node "$PLUGIN_PATH/src/cli.js" "$@"